{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "desktop/**",
      "androidtv/**",
      "worker/**",
      "automation/**",
      "FIREBASE-SETUP.md",
      "MIGRACION-HOSTING.md",
      "README.md",
      "descargas/*.apk"
    ],
    "redirects": [
      { "source": "/descargas/:file", "destination": "https://raw.githubusercontent.com/all-anime01/all-animelat/main/descargas/:file", "type": 302 }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
      },
      {
        "source": "**/*.@(svg|png|jpg|jpeg|webp|ico|gif|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      },
      {
        "source": "/vosk/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
